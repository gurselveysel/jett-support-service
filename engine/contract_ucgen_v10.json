  },
  "academic_contract": {
    "given": "ABC üçgeninde m(B) = 60°, m(DAC) = 10°, m(C) = 10°, |BD| = 2 birim (D, BC üzerinde).",
    "asked": "|AC| uzunluğu kaç birimdir?",
    "primary_outcome": "Açıları ayrıştırıp ikizkenarlık ve sinüs teoremiyle bilinmeyen kenarı hesaplar.",
    "prerequisites": [
      "Üçgenin iç açıları toplamı 180 derecedir.",
      "Sinüs teoremi: a/sinA = b/sinB.",
      "Taban açıları eşit olan üçgen ikizkenardır."
    ]
  },
  "canonical_solution": {
    "steps": [
      {
        "step_no": 1,
        "action": "Açıları ayır",
        "reason": "m(A) = 180 - 60 - 10 = 110° → m(BAD) = 100°, m(DAC) = 10°."
      },
      {
        "step_no": 2,
        "action": "İkizkenarı gör",
        "reason": "ΔACD'de 10° = 10° → AD = DC."
      },
      {
        "step_no": 3,
        "action": "ΔABD'de sinüs teoremi",
        "reason": "AD/sin60 = 2/sin100 → AD = 2·sin60/sin100."
      },
      {
        "step_no": 4,
        "action": "ΔACD'de sinüs teoremi",
        "reason": "AC = 2·AD·cos10."
      },
      {
        "step_no": 5,
        "action": "Sadeleştir",
        "reason": "sin100 = cos10 → AC = 4·sin60 = 2√3."
      }
    ],
    "final_answer": {
      "value": "2√3",
      "display": "AC = 2√3"
    }
  },
